<Window x:Class="YrClean.UI.DiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YrClean.UI"
        Title="{local:Loc Disk_Title}"
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Name="DrivesText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{local:Loc Disk_Folder}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Name="FolderBox" Grid.Column="1" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="{local:Loc Disk_Browse}" Width="90" Height="30" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>

        <StackPanel Name="ActionsPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{local:Loc Disk_Largest}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="Analyze_Click"/>
            <Button Content="{local:Loc Disk_Old}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="OldFiles_Click"/>
            <Button Content="{local:Loc Disk_Duplicates}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="Duplicates_Click"/>
            <Button Name="CancelButton" Content="{local:Loc Common_Cancel}" Height="34" Width="80" IsEnabled="False" Click="Cancel_Click"/>
            <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="{local:Loc Disk_ViewOnly}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2F2F2F" BorderThickness="0,0,0,1" Padding="4,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DetailVisibility}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Button Grid.Column="2" Content="{local:Loc Common_Open}" Width="60" Height="24" Margin="10,0,0,0"
                                        Visibility="{Binding OpenVisibility}" Click="Open_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
