<Window x:Class="YrClean.UI.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YrClean.UI"
        Title="{local:Loc Quar_Title}"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TreeView Name="OperationsTree"
                  Grid.Row="1"
                  Background="{DynamicResource BackgroundMain}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="#2F2F2F"
                  BorderThickness="1">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:OperationNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type local:QuarantinedFileNode}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{local:Loc Quar_Restore}" Width="150" Height="34" Margin="0,0,10,0" Click="RestoreButton_Click"/>
            <Button Content="{local:Loc Common_Close}" Width="90" Height="34" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
