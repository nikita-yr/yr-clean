<Window x:Class="YrClean.UI.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System tools"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <WrapPanel Name="ActionsPanel" Grid.Row="1">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                </Style>
            </WrapPanel.Resources>
            <Button Name="CheckSystemButton" Content="Check system (DISM + SFC)"
                    ToolTip="Repairs the Windows component store, then verifies system files. Can take 15-40 minutes."
                    Click="CheckSystem_Click"/>
            <Button Name="ComponentCleanupButton" Content="Clean up component store"
                    ToolTip="DISM /Online /Cleanup-Image /StartComponentCleanup - removes superseded Windows components."
                    Click="ComponentCleanup_Click"/>
            <Button Name="UpdateCacheButton" Content="Clear Windows Update cache"
                    ToolTip="Stops the Windows Update service, moves old downloaded update files to quarantine, starts the service again."
                    Click="UpdateCache_Click"/>
            <Button Name="RecycleBinButton" Content="Empty Recycle Bin" Click="RecycleBin_Click"/>
            <Button Name="WindowsOldButton" Content="Remove Windows.old (expert)"
                    ToolTip="Deletes the previous Windows installation. You will no longer be able to roll back to it."
                    Click="WindowsOld_Click"/>
            <Button Name="RestorePointButton" Content="Create restore point" Click="RestorePoint_Click"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Name="StatusText" Text="Ready." Margin="0,0,0,4"/>
                <ProgressBar Name="Progress" Height="10" Minimum="0" Maximum="100"/>
            </StackPanel>
            <Button Name="CancelButton" Grid.Column="1" Content="Cancel" Width="90" Height="32" Margin="10,0,0,0"
                    IsEnabled="False" Click="Cancel_Click"/>
        </Grid>

        <TextBox Name="OutputBox" Grid.Row="3"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"/>
    </Grid>
</Window>
