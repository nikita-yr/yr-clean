<Window x:Class="YrClean.UI.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YrClean.UI"
        Title="{local:Loc Tools_Title}"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <WrapPanel Name="ActionsPanel" Grid.Row="1">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                </Style>
            </WrapPanel.Resources>
            <Button Name="CheckSystemButton" Content="{local:Loc Tools_Check}"
                    ToolTip="{local:Loc Tools_CheckTip}"
                    Click="CheckSystem_Click"/>
            <Button Name="ComponentCleanupButton" Content="{local:Loc Tools_Component}"
                    ToolTip="{local:Loc Tools_ComponentTip}"
                    Click="ComponentCleanup_Click"/>
            <Button Name="UpdateCacheButton" Content="{local:Loc Tools_UpdateCache}"
                    ToolTip="{local:Loc Tools_UpdateCacheTip}"
                    Click="UpdateCache_Click"/>
            <Button Name="RecycleBinButton" Content="{local:Loc Tools_RecycleBin}" Click="RecycleBin_Click"/>
            <Button Name="WindowsOldButton" Content="{local:Loc Tools_WindowsOld}"
                    ToolTip="{local:Loc Tools_WindowsOldTip}"
                    Click="WindowsOld_Click"/>
            <Button Name="RestorePointButton" Content="{local:Loc Tools_RestorePoint}" Click="RestorePoint_Click"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Name="StatusText" Text="{local:Loc Tools_Ready}" Margin="0,0,0,4"/>
                <ProgressBar Name="Progress" Height="10" Minimum="0" Maximum="100"/>
            </StackPanel>
            <Button Name="CancelButton" Grid.Column="1" Content="{local:Loc Common_Cancel}" Width="90" Height="32" Margin="10,0,0,0"
                    IsEnabled="False" Click="Cancel_Click"/>
        </Grid>

        <TextBox Name="OutputBox" Grid.Row="3"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"/>
    </Grid>
</Window>
