<Window x:Class="YrClean.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YrClean.UI"
        Title="YrClean"
        Height="660" Width="1040"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Background="{DynamicResource BackgroundMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundHeader}"
                BorderBrush="#2F2F2F"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox Name="SelectAllCheck"
                          Content="{local:Loc Main_SelectAll}"
                          Foreground="{DynamicResource TextPrimary}"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"
                          Checked="SelectAllCheck_Checked"
                          Unchecked="SelectAllCheck_Unchecked"/>

                <Button Name="CleanButton"
                        Content="{local:Loc Main_Clean}"
                        MinWidth="150" Height="40" Padding="14,0"
                        Margin="0,0,10,0"
                        Click="CleanButton_Click"/>

                <Button Name="QuarantineButton"
                        Content="{local:Loc Main_Quarantine}"
                        MinWidth="90" Height="40" Padding="14,0"
                        Margin="0,0,10,0"
                        ToolTip="{local:Loc Main_QuarantineTip}"
                        Click="QuarantineButton_Click"/>

                <Button Name="ToolsButton"
                        Content="{local:Loc Main_System}"
                        MinWidth="80" Height="40" Padding="14,0"
                        Margin="0,0,10,0"
                        ToolTip="{local:Loc Main_SystemTip}"
                        Click="ToolsButton_Click"/>

                <Button Name="StartupButton"
                        Content="{local:Loc Main_Startup}"
                        MinWidth="80" Height="40" Padding="14,0"
                        Margin="0,0,10,0"
                        ToolTip="{local:Loc Main_StartupTip}"
                        Click="StartupButton_Click"/>

                <Button Name="DiskButton"
                        Content="{local:Loc Main_Disk}"
                        MinWidth="70" Height="40" Padding="14,0"
                        Margin="0,0,10,0"
                        ToolTip="{local:Loc Main_DiskTip}"
                        Click="DiskButton_Click"/>

                <Button Name="LeftoversButton"
                        Content="{local:Loc Main_Leftovers}"
                        MinWidth="90" Height="40" Padding="14,0"
                        Margin="0,0,10,0"
                        ToolTip="{local:Loc Main_LeftoversTip}"
                        Click="LeftoversButton_Click"/>

                <Button Name="ScheduleButton"
                        Width="36" Height="36"
                    Padding="0"
                        ToolTip="{local:Loc Settings_Title}"
                        Click="ScheduleButton_Click">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Name="LowSpaceText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="#E0A030" FontWeight="Bold" Margin="12,8,12,0"/>

        <TreeView Name="ResultsTree"
                  Grid.Row="2"
                  Margin="10"
                  Background="{DynamicResource BackgroundMain}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="#2F2F2F"
                  BorderThickness="1"
                  Grid.IsSharedSizeScope="True">
            <TreeView.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>

                <!-- Shared by source and group rows; x:Shared=False gives each row its own instance -->
                <ContextMenu x:Key="FolderContextMenu" x:Shared="False"
                             Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                    <MenuItem Header="{local:Loc Menu_OpenFolder}" Click="OpenLocation_Click"/>
                    <MenuItem Header="{local:Loc Menu_SearchWeb}" Click="SearchWeb_Click"/>
                    <MenuItem Header="{local:Loc Menu_AddExclusion}" Click="AddToExclusions_Click"/>
                </ContextMenu>

                <HierarchicalDataTemplate DataType="{x:Type local:CacheSourceNode}" ItemsSource="{Binding Children}">
                    <Grid Width="840" ContextMenu="{StaticResource FolderContextMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type local:CacheGroupNode}" ItemsSource="{Binding Children}">
                    <Grid Width="820" ContextMenu="{StaticResource FolderContextMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                    </Grid>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type local:CacheFileNode}">
                    <Grid Width="800">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <Grid.ContextMenu>
                            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                <MenuItem Header="{local:Loc Menu_OpenFile}" Click="OpenLocation_Click"/>
                                <MenuItem Header="{local:Loc Menu_SearchWeb}" Click="SearchWeb_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</Window>
