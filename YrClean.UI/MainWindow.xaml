<Window x:Class="YrClean.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YrClean.UI"
        Title="YrClean"
        Height="600" Width="800"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Background="{DynamicResource BackgroundMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundHeader}"
                BorderBrush="#2F2F2F"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox Name="SelectAllCheck"
                          Content="Select all"
                          Foreground="{DynamicResource TextPrimary}"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"
                          Checked="SelectAllCheck_Checked"
                          Unchecked="SelectAllCheck_Unchecked"/>

                <Button Name="CleanButton"
                        Content="Clean"
                        Width="150" Height="40"
                        Margin="0,0,10,0"
                        Click="CleanButton_Click"/>

                <Button Name="ScheduleButton"
                        Width="36" Height="36"
                    Padding="0"
                        ToolTip="Schedule settings"
                        Click="ScheduleButton_Click">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <TreeView Name="ResultsTree"
                  Grid.Row="1"
                  Margin="10"
                  Background="{DynamicResource BackgroundMain}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="#2F2F2F"
                  BorderThickness="1"
                  Grid.IsSharedSizeScope="True">
            <TreeView.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>

                <!-- Shared by source and group rows; x:Shared=False gives each row its own instance -->
                <ContextMenu x:Key="FolderContextMenu" x:Shared="False"
                             Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                    <MenuItem Header="Open folder location" Click="OpenLocation_Click"/>
                    <MenuItem Header="Search on the web" Click="SearchWeb_Click"/>
                    <MenuItem Header="Add to exclusions" Click="AddToExclusions_Click"/>
                </ContextMenu>

                <HierarchicalDataTemplate DataType="{x:Type local:CacheSourceNode}" ItemsSource="{Binding Children}">
                    <Grid Width="640" ContextMenu="{StaticResource FolderContextMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type local:CacheGroupNode}" ItemsSource="{Binding Children}">
                    <Grid Width="620" ContextMenu="{StaticResource FolderContextMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                    </Grid>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type local:CacheFileNode}">
                    <Grid Width="600">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondary}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <Grid.ContextMenu>
                            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                <MenuItem Header="Open file location" Click="OpenLocation_Click"/>
                                <MenuItem Header="Search on the web" Click="SearchWeb_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</Window>
