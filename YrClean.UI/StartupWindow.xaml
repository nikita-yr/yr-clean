<Window x:Class="YrClean.UI.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup programs"
        Height="560" Width="860"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2F2F2F" BorderThickness="0,0,0,1" Padding="4,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Top"
                                          Margin="0,2,10,0" ToolTip="Start with Windows" Click="EnabledCheck_Click"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Flags}" Foreground="#E0A030" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
