<Window x:Class="YrClean.UI.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program leftovers"
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource BackgroundMain}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="StatusText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Text="Scanning..."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2F2F2F" BorderThickness="0,0,0,1" Padding="4,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding CheckVisibility}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                               Visibility="{Binding DetailVisibility}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Button Grid.Column="3" Content="Open" Width="60" Height="24" Margin="10,0,0,0"
                                        Visibility="{Binding OpenVisibility}" Click="Open_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="QuarantineButton" Content="Move selected folders to quarantine" Height="34" Padding="14,0"
                    Margin="0,0,10,0" IsEnabled="False" Click="Quarantine_Click"/>
            <Button Content="Close" Width="90" Height="34" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
