<Window x:Class="YrClean.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YrClean.UI"
        Title="{local:Loc Settings_Title}" Height="740" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E1E1E1">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#7A7A7A"/>
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#7A7A7A"/>
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <CheckBox Name="ScheduleEnabledCheck" Content="{local:Loc Settings_Enable}" FontWeight="Bold"/>

        <TextBlock Text="{local:Loc Settings_OlderThan}" Foreground="#E1E1E1" Margin="0,16,0,4"/>
        <ComboBox Name="AgeThresholdCombo" SelectionChanged="AgeThresholdCombo_SelectionChanged">
            <ComboBoxItem Content="{local:Loc Age_1Day}" Tag="1"/>
            <ComboBoxItem Content="{local:Loc Age_1Week}" Tag="7"/>
            <ComboBoxItem Content="{local:Loc Age_2Weeks}" Tag="14"/>
            <ComboBoxItem Content="{local:Loc Age_1Month}" Tag="30"/>
            <ComboBoxItem Content="{local:Loc Age_3Months}" Tag="90"/>
            <ComboBoxItem Content="{local:Loc Age_6Months}" Tag="180"/>
            <ComboBoxItem Content="{local:Loc Age_1Year}" Tag="365"/>
            <ComboBoxItem Content="{local:Loc Age_Custom}" Tag="custom"/>
        </ComboBox>

        <TextBlock Name="CustomDaysLabel" Text="{local:Loc Settings_CustomDays}" Foreground="#E1E1E1" Margin="0,12,0,4"/>
        <TextBox Name="CustomDaysTextBox" Text="14"/>

        <TextBlock Text="{local:Loc Settings_Frequency}" Foreground="#E1E1E1" Margin="0,16,0,4"/>
        <ComboBox Name="FrequencyCombo" SelectionChanged="FrequencyCombo_SelectionChanged">
            <ComboBoxItem Content="{local:Loc Freq_Hourly}"/>
            <ComboBoxItem Content="{local:Loc Freq_Daily}"/>
            <ComboBoxItem Content="{local:Loc Freq_Weekly}"/>
        </ComboBox>

        <TextBlock Name="DayLabel" Text="{local:Loc Settings_DayOfWeek}" Foreground="#E1E1E1" Margin="0,12,0,4"/>
        <ComboBox Name="DayCombo">
            <ComboBoxItem Content="{local:Loc Day_Monday}"/>
            <ComboBoxItem Content="{local:Loc Day_Tuesday}"/>
            <ComboBoxItem Content="{local:Loc Day_Wednesday}"/>
            <ComboBoxItem Content="{local:Loc Day_Thursday}"/>
            <ComboBoxItem Content="{local:Loc Day_Friday}"/>
            <ComboBoxItem Content="{local:Loc Day_Saturday}"/>
            <ComboBoxItem Content="{local:Loc Day_Sunday}"/>
        </ComboBox>

        <CheckBox Name="NotifyCheck" Content="{local:Loc Settings_Notify}" Margin="0,16,0,0"/>

        <CheckBox Name="MaintenanceCheck" Content="{local:Loc Settings_Maintenance}" FontWeight="Bold" Margin="0,16,0,0"/>
        <TextBlock Text="{local:Loc Settings_DayOfMonth}" Foreground="#E1E1E1" Margin="0,8,0,4"/>
        <TextBox Name="MaintenanceDayTextBox" Text="1"/>

        <TextBlock Text="{local:Loc Settings_LowSpace}" Foreground="#E1E1E1" Margin="0,12,0,4"/>
        <TextBox Name="LowSpaceTextBox" Text="15"/>

        <CheckBox Name="UseWinapp2Check"
                  Content="{local:Loc Settings_Winapp2}"
                  Margin="0,10,0,0"/>

        <TextBlock Text="{local:Loc Settings_QuarantineDays}" Foreground="#E1E1E1" Margin="0,16,0,4"/>
        <TextBox Name="QuarantineDaysTextBox" Text="7"/>

        <TextBlock Text="{local:Loc Settings_Language}" Foreground="#E1E1E1" Margin="0,16,0,4"/>
        <ComboBox Name="LanguageCombo">
            <ComboBoxItem Content="{local:Loc Lang_System}" Tag=""/>
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Українська" Tag="uk-UA"/>
            <ComboBoxItem Content="Русский" Tag="ru-RU"/>
            <ComboBoxItem Content="Polski" Tag="pl-PL"/>
        </ComboBox>

        <Button Content="{local:Loc Settings_Save}" Height="32" Margin="0,20,0,0" Click="SaveButton_Click"/>
        <TextBlock Name="StatusText" Foreground="#E1E1E1" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>